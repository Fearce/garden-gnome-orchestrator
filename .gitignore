# deps
node_modules/
*/node_modules/
# Only the per-workspace lockfiles are tracked (server/, web/). The ROOT package.json exists solely for
# `concurrently`, and `npm install` at the root — a documented first-run step — regenerates a root lockfile
# that upstream has never tracked, so it would otherwise sit in `git status` forever as stray noise.
/package-lock.json

# build output
server/dist/
server/.ide-lab-dist/
server/.task-model-lab-dist/
server/.start-immediately-lab-dist/
server/.code-nav-lab-dist/
server/.settled-lab-dist/
server/.reset-redeem-lab-dist/
server/.cowork-lab-dist/
server/.chip-lab-dist/
server/.directives-lab-dist/
server/.directives-lab-web-dist/
server/.token-safety-lab-dist/
server/.subtask-lab-dist/
server/.remote-access-lab-dist/
server/.remote-lab-dist/
server/.goals-lab-dist/
server/.task-agents-lab-dist/
server/.patch-notes-lab-dist/
server/.pin-lab-dist/
server/.board-head-lab-dist/
server/.agent-names-lab-dist/
server/.task-header-lab-dist/
server/.livebench-lab-dist/
server/.repo-chips-lab-dist/
server/.calendar-lab-dist/
server/.lab-web-dist*/
web/dist/
relay/dist/
*.tsbuildinfo

# runtime state
server/data/
/relay/data/
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.log

# secrets / env
.env
.env.local
*/.env
*/.env.local
# Environment variants and backups can contain the same secrets as .env. Keep templates publishable.
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
.claude/settings.local.json
# one operator's relay host / key / proxy network (template: relay/deploy.env.example)
relay/deploy.env
# the operator's private words for the privacy guard (server/scripts/privacy-guard.cjs)
server/.privacy-terms

# agent scratch probes (throwaway e2e / db dumps; deliverable detector also ignores _*)
server/src/tests/_*
server/src/tests/_*.png
server/scripts/_*
server/_*.cjs
server/_*.ts
server/_*.py
server/_*.png

# root-level agent scratch (throwaway worktrees, evidence archives, git bundles). Same _* convention
# as above, but at the repo root: several agents share this checkout, so a stray `git add -A` would
# otherwise sweep in tens of MB of archive bundles.
/_*/

# editor
.vscode/
.idea/
.DS_Store
