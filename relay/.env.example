# Copy to `.env` next to docker-compose.yml on the host. Never commit the real file.

# The code a new orchestrator instance pastes once in Settings → Online office. Anyone holding it can
# join the office, so treat it like a password: 20+ random characters, rotated by editing this line and
# restarting (already-joined instances keep working — they hold device tokens, not the code).
#
# Left EMPTY on purpose. The relay refuses to start without it, and refuses to start with a placeholder —
# an office is only as private as this string, and this file is in a public repository. Generate one with:
#     openssl rand -base64 24 | tr -d /+=
JOIN_CODE=

# Unlocks /admin?key=… and the member API (revoking a device). Leave empty to disable both surfaces.
ADMIN_TOKEN=

# Shown as the office's name on the status page.
OFFICE_NAME=GG Online Office

# Days an UNUSED device token stays valid. Every connect slides it forward, so a machine that talks to
# the office regularly never re-authenticates; one that goes quiet this long has to be re-invited.
TOKEN_TTL_DAYS=180

# Wrong join codes tolerated from one address per hour.
JOIN_ATTEMPTS_PER_HOUR=10

# Hours an /admin?key=… visit stays signed in via its session cookie, so the key stops travelling in the
# URL (and therefore in the proxy's access log and the browser's history) on every subsequent visit.
ADMIN_SESSION_HOURS=12

# Reverse-proxy hops in front of the relay that APPEND to X-Forwarded-For. 1 = the documented deployment
# (Caddy, and nothing else). Raise it only if you add another proxy in front — and never to reach past
# one, because everything further left in that header is written by the caller and can say anything.
TRUSTED_PROXY_HOPS=1
