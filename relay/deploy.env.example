# Copy to `deploy.env` beside deploy.sh (gitignored) and fill in your own relay host. deploy.sh sources it.
# Every value can also be passed as an environment variable instead.

# SSH target that owns the relay directory and is in the host's docker group.
OFFICE_RELAY_HOST=deploy@203.0.113.10

# Private key for that user. Defaults to ~/.ssh/id_ed25519.
OFFICE_RELAY_KEY=$HOME/.ssh/id_ed25519

# Docker network your reverse proxy (Caddy, Traefik, nginx) is already on; the relay joins it and publishes
# no host port. Written into the host's `.env` as RELAY_PROXY_NETWORK on the first deploy that lacks it.
OFFICE_RELAY_NETWORK=caddy_default

# Remote directory for the relay, expanded on the host. Defaults to $HOME/gg-office-relay.
# OFFICE_RELAY_DIR=/srv/gg-office-relay
